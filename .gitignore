# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# env files — never commit real keys (LiveKit, Supabase).
# .env.example is a template with names only, so it's safe to share.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI (migrations in supabase/migrations stay tracked)
supabase/.temp/
supabase/.branches/

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# editors & local tool settings
.idea/
.vscode/*
!.vscode/extensions.json
.claude/

# certificates
*.pem

# local AI assistant notes
AGENTS.md
CLAUDE.md
