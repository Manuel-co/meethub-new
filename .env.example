# Copy this file to .env and fill in your own values. Never commit .env.

# LiveKit Cloud (video calls) — cloud.livekit.io → your project → Settings → API Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase (accounts + database) — supabase.com → your project → Connect / Settings → API Keys
# The anon/publishable key is safe in the browser; access is enforced by the
# row-level security rules in supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
